# Personal data — never commit. config/ is all yours (starters: config_templates/).
config/
data/
.env
.env.*
!.env.personal.example

# Demo output (`radar demo` workspace)
demo-run/

# Python / tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# OS / editors
.DS_Store
.idea/
.vscode/

# Local-only files (e.g. full, unscrubbed originals of test samples) — never committed
local/

# Personal working notes, kept locally only
docs/KICKOFF_PROMPTS.md

# Tests named *_yours.py check samples from companies on your own list: they stay on your
# machine. Their samples are listed in .git/info/exclude (local, never committed).
tests/**/*_yours.py
