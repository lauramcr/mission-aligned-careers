# Copy to .env to run `docker compose up` on your own data instead of the demo.
# Paths are inside the project folder (mounted into the containers). .env is gitignored.
JOB_RADAR_CRITERIA=config/criteria.yaml
JOB_RADAR_COMPANIES=config/companies.csv
JOB_RADAR_PENDING=config/companies_pending.csv
JOB_RADAR_SOURCES=config/sources.yaml
JOB_RADAR_DECISIONS=config/decisions.csv
JOB_RADAR_DB=data/radar.duckdb
JOB_RADAR_REPORTS=data/digests
JOB_RADAR_SCORES_CSV=data/scores.csv
JOB_RADAR_CACHE=data/cache
JOB_RADAR_CV=config/cv.md
# Empty = live web (no replay). Facts use free keywords: Claude Code isn't in the container.
JOB_RADAR_REPLAY_DIR=
